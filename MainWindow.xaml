<Window x:Class="PassLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pass Login - Secure Access" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <TextBlock Text="Secure Login" FontSize="28" FontWeight="Bold" Foreground="#333" Margin="0,0,0,30" TextAlignment="Center"/>
            
            <!-- Password Login Section -->
            <TextBlock Text="Password Sign-In" FontSize="16" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,10"/>
            <TextBlock Text="Username:" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox" Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"/>
            
            <TextBlock Text="Password:" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"/>
            
            <Button Content="Sign In" Height="40" FontSize="14" Background="#007ACC" Foreground="White" Click="SignInButton_Click" Margin="0,0,0,20"/>
            
            <!-- Optional Features Section -->
            <Separator Margin="0,10,0,10" Background="#DDD"/>
            
            <TextBlock Text="Optional Authentication Methods" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,15"/>
            
            <Button Content="📱 Sign In with QR Code" Height="35" FontSize="12" Background="#28A745" Foreground="White" Click="QRButton_Click" Margin="0,0,0,10"/>
            
            <Button Content="📷 Sign In with Camera Recognition" Height="35" FontSize="12" Background="#FF6B6B" Foreground="White" Click="CameraButton_Click" Margin="0,0,0,20"/>
            
            <!-- Status Message -->
            <TextBlock x:Name="StatusMessage" Text="" Foreground="#D32F2F" TextAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
